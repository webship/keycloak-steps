{
  "name": "@webship-js/keycloak-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for the sign-in of any app that uses Keycloak, a plugin for webship-js (Playwright and Cucumber): the login page and its refusals, \"Remember me\", the registration form's refusals, forgot password through the mail catcher, the required actions (update the password, verify the email, set up a one-time code), one-time codes worked out from the account's secret the way an authenticator app does, the consent screen, logout, the error pages, the account console (personal info, signing in, devices, applications), and the admin console (find and open a user, reset a test account's password, the realm's clients and roles).",
  "main": "tests/step-definitions/keycloak-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "keycloak",
    "sign-in",
    "single-sign-on",
    "openid-connect",
    "one-time-code",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/keycloak-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/keycloak-steps/issues"
  },
  "homepage": "https://github.com/webship/keycloak-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
